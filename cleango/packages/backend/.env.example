# =============================================
# CleanGo Backend — Environment Variables
# =============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ----- Server -----
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# ----- Firebase Admin SDK -----
# Path to your downloaded service account JSON key
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# OR set these individual vars instead of the file path:
# FIREBASE_PROJECT_ID=cleango-prod
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@cleango-prod.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

FIREBASE_STORAGE_BUCKET=cleango-prod.appspot.com
FIREBASE_DATABASE_URL=https://cleango-prod-default-rtdb.firebaseio.com

# ----- Paystack -----
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret
# Platform commission percentage (15 = 15%)
PLATFORM_COMMISSION_PERCENT=15

# ----- Twilio (SMS & WhatsApp) -----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ----- SendGrid (Email) -----
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@cleango.ng
SENDGRID_FROM_NAME=CleanGo

# ----- JWT -----
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ----- Rate Limiting -----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ----- App Settings -----
# Kaduna State coordinates (centre point)
KADUNA_LAT=10.5264
KADUNA_LNG=7.4381
TIMEZONE=Africa/Lagos

# Escrow auto-release after N hours if no dispute
ESCROW_AUTO_RELEASE_HOURS=48

# ----- CORS -----
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006,https://cleango.ng
